pipeline {
    agent any

    environment {
        CLIENT_IMAGE     = 'ashwinsai22/kr-market-client'
        SERVER_IMAGE     = 'ashwinsai22/kr-market-server'
        IMAGE_TAG        = "1.0.${env.BUILD_NUMBER}"
        DOCKER_CREDS     = 'docker'
        GITOPS_REPO      = 'git@github.com:ashwinsai22/ecommerce-gitops.git'
        SSH_CREDS        = 'github-ssh-creds'
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Build & Push Docker Images') {
            steps {
                script {
                    withDockerRegistry(credentialsId: DOCKER_CREDS, url: 'https://index.docker.io/v1/') {
                        parallel(
                            'Build Client': {
                                sh """
                                    echo "Building Client: ${CLIENT_IMAGE}:${IMAGE_TAG}"
                                    docker build -t ${CLIENT_IMAGE}:${IMAGE_TAG} -t ${CLIENT_IMAGE}:latest -f Dockerfile.client .
                                    docker push ${CLIENT_IMAGE}:${IMAGE_TAG}
                                    docker push ${CLIENT_IMAGE}:latest
                                """
                            },
                            'Build Server': {
                                sh """
                                    echo "Building Server: ${SERVER_IMAGE}:${IMAGE_TAG}"
                                    docker build -t ${SERVER_IMAGE}:${IMAGE_TAG} -t ${SERVER_IMAGE}:latest -f Dockerfile.server .
                                    docker push ${SERVER_IMAGE}:${IMAGE_TAG}
                                    docker push ${SERVER_IMAGE}:latest
                                """
                            }
                        )
                    }
                }
            }
        }

        stage('Update GitOps Dev Environment') {
            steps {
                sshagent(credentials: [SSH_CREDS]) {
                    sh """
                        export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no"

                        rm -rf ecommerce-gitops
                        git clone ${GITOPS_REPO} ecommerce-gitops
                        cd ecommerce-gitops/environments/dev

                        if command -v kustomize > /dev/null 2>&1; then
                            kustomize edit set image ${CLIENT_IMAGE}=${CLIENT_IMAGE}:${IMAGE_TAG}
                            kustomize edit set image ${SERVER_IMAGE}=${SERVER_IMAGE}:${IMAGE_TAG}
                        else
                            sed -i -E 's|(${CLIENT_IMAGE}[[:space:]]*newTag:[[:space:]]*).*|\\1"${IMAGE_TAG}"|g' kustomization.yaml || true
                            sed -i -E 's|(${SERVER_IMAGE}[[:space:]]*newTag:[[:space:]]*).*|\\1"${IMAGE_TAG}"|g' kustomization.yaml || true
                        fi

                        git config user.name "ashwinsai22"
                        git config user.email "ashwinsai22@users.noreply.github.com"
                        git add kustomization.yaml

                        if ! git diff --quiet || ! git diff --staged --quiet; then
                            git commit -m "ci(dev): minikube full-stack bump to ${IMAGE_TAG} [skip ci]"
                            git push origin main || git push origin master
                        else
                            echo "No changes detected in kustomization.yaml."
                        fi
                    """
                }
            }
        }
    }

    post {
        success {
            echo "=================================================================="
            echo "SUCCESS: Full-stack release ${IMAGE_TAG} published to GitOps Dev!"
            echo "Argo CD will pick up changes shortly."
            echo "=================================================================="
        }
        failure {
            echo "Pipeline failed. Check logs above."
        }
    }
}
