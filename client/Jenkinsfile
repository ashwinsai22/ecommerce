def sonarStatus = "NOT_EXECUTED"
def owaspStatus = "NOT_EXECUTED"
def trivyStatus = "NOT_EXECUTED"

pipeline {
    agent any
    triggers {
        pollSCM('H/5 * * * *')
    }
    tools {
        nodejs 'node18'
        jdk 'jdk21'
    }

    parameters {

        gitParameter(
            name: 'GIT_BRANCH',
            type: 'PT_BRANCH',
            defaultValue: 'master',
            branchFilter: '.*',
            sortMode: 'DESCENDING_SMART',
            selectedValue: 'DEFAULT',
            quickFilterEnabled: false,
            description: 'Select Git Branch'
        )

        booleanParam(name: 'ENFORCE_SONAR_QG', defaultValue: false)
        booleanParam(name: 'ENFORCE_OWASP', defaultValue: false)
        booleanParam(name: 'ENFORCE_TRIVY_FS', defaultValue: false)
    }

    environment {
        IMAGE_NAME = 'ashwinsai22/kr-market-client'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        /* ================= CHECKOUT ================= */

        stage('Checkout') {
            steps {
                script {

                    // ✅ remove origin/ automatically
                    def branchName = params.GIT_BRANCH.replaceFirst(/^origin\\//, "")

                    echo "Checking out branch: ${branchName}"

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${branchName}"]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/ashwinsai22/ecommerce.git',
                            credentialsId: 'github-creds'
                        ]]
                    ])
                }
            }
        }

        /* ================= SONAR ================= */

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    script {
                        def scannerHome = tool 'sonar-scanner'

                        sh """
                        cd client
                        ${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=kr-market-client \
                        -Dsonar.projectName=kr-market-client \
                        -Dsonar.sources=.
                        """
                    }
                }
            }
        }

        stage('Sonar Quality Gate') {
            steps {
                script {
                    timeout(time: 5, unit: 'MINUTES') {
                        def qg = waitForQualityGate abortPipeline: false
                        sonarStatus = qg.status

                        if (qg.status != 'OK' && params.ENFORCE_SONAR_QG) {
                            error("Sonar Quality Gate failed")
                        }
                    }
                }
            }
        }

        /* ================= BUILD ================= */

        stage('Build Client') {
            steps {
                sh '''
                cd client
                npm install
                npm run build
                '''
            }
        }

        /* ================= OWASP ================= */

        stage('OWASP Dependency Check') {
            steps {
                withCredentials([
                    string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')
                ]) {
                    script {

                        def dpCheck = tool 'DP-Check'

                        def status = sh(
                        script: '''
                        cd client
                        ''' + dpCheck + '''/bin/dependency-check.sh \
                        --scan ./ \
                        --noupdate \
                        --disableNodeAudit \
                        --format XML \
                        --out .
                        ''',
                        returnStatus: true
)

                        owaspStatus = status == 0 ? "PASS" : "FAILED"

                        if (status != 0 && params.ENFORCE_OWASP) {
                            error("OWASP vulnerabilities found")
                        }
                    }
                }
            }
        }

        /* ================= TRIVY ================= */

        stage('Trivy FS Scan') {
            steps {
                script {
                    def status = sh(
                        script: 'trivy fs client/',
                        returnStatus: true
                    )

                    trivyStatus = status == 0 ? "PASS" : "FAILED"

                    if (status != 0 && params.ENFORCE_TRIVY_FS) {
                        error("Trivy vulnerabilities found")
                    }
                }
            }
        }

        /* ================= DOCKER ================= */

        stage('Docker Build & Push') {
            steps {
                withDockerRegistry(
                    credentialsId: 'docker',
                    url: 'https://index.docker.io/v1/'
                ) {
                    sh '''
                    docker build -t $IMAGE_NAME:latest -f Dockerfile.client .
                    docker push $IMAGE_NAME:latest
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh 'trivy image $IMAGE_NAME:latest || true'
            }
        }
    }

    /* ================= EMAIL ================= */

    post {
        always {
            script {

                def buildColor =
                    currentBuild.currentResult == "SUCCESS" ? "#28a745" :
                    currentBuild.currentResult == "UNSTABLE" ? "#ffc107" :
                    "#dc3545"

                def statusColor = { s ->
                    (s == "OK" || s == "PASS")
                        ? "<span style='color:#28a745;font-weight:bold'>🟢 ${s}</span>"
                        : "<span style='color:#dc3545;font-weight:bold'>🔴 ${s}</span>"
                }

                emailext(
                    mimeType: 'text/html',
                    subject: "KR Market Frontend CI - ${JOB_NAME} #${BUILD_NUMBER}",
                    body: """
<h2>KR Market Frontend CI Report</h2>

<b>Branch:</b> ${params.GIT_BRANCH}<br>
<b>Status:</b> <span style="color:${buildColor}">
${currentBuild.currentResult}</span><br><br>

<table border="1" cellpadding="8">
<tr><th>Scan</th><th>Status</th></tr>
<tr><td>SonarQube</td><td>${statusColor(sonarStatus)}</td></tr>
<tr><td>OWASP</td><td>${statusColor(owaspStatus)}</td></tr>
<tr><td>Trivy</td><td>${statusColor(trivyStatus)}</td></tr>
</table>

<br>
<a href="${BUILD_URL}">Open Build</a>
""",
                    attachLog: true,
                    to: 'ponugumatiashwinsai@gmail.com'
                )
            }
        }
    }
}